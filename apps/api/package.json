{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev --name init --skip-generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "load:cdd": "tsx scripts/load_cdd.ts",
    "load:cdd:quiz": "tsx scripts/load_cdd_quiz.ts",
    "fix:cdd:edd": "tsx scripts/update_cdd_edd_question.ts",
    "list:cdd:questions": "tsx scripts/list_cdd_questions.ts",
    "fix:cdd:convert-short-edd": "tsx scripts/fix_cdd_convert_short_edd.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^6.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.16.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
