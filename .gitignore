*.tsbuildinfo
**/*.tsbuildinfo

# Next.js
.next/
**/.next/
out/
**/out/
.vercel/
**/.vercel/
.netlify/
**/.netlify/

# Logs
logs
**/logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / Coverage
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# Env files (keep examples)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Temporary / Caches
tmp/
**/tmp/
.tmp/
**/.tmp/
.cache/
**/.cache/

# Prisma (generated engines live under node_modules/.prisma)
.prisma/
**/.prisma/

# Docker local data (if any)
